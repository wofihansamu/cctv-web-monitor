# Copy this file to secrets.env (gitignored) and fill in the values.
# DO NOT commit secrets.env.
#
# Only the camera's own credentials are needed — a vendor ACCOUNT login is NOT
# required: UID + camera password reach ON_LINE over the vendor relay on their
# own (verified 2026-10-23).

XIOT_CAM_UID=XIOTB-XXXXXX-XXXXX   # camera UID (as printed on the device / app)
XIOT_CAM_USER=admin               # camera user (default: admin)
XIOT_CAM_PWD=                     # camera password

# Stream mode: 1 = 640x480 (best this camera offers), 2 = 320x240. This device
# is MJPEG-only; there is no H.264 / HD stream regardless of the app's labels.
XIOT_STREAM=1
