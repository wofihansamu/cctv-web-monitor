# Copy to .env and adjust.
PORT=3000
# Where the Node server reaches the go2rtc API (docker-compose sets this to the service name).
GO2RTC_URL=http://localhost:1984
# Public base URL go2rtc exposes to browsers for WebRTC/MSE (usually same host:1984).
GO2RTC_PUBLIC_URL=http://localhost:1984

# Recording (needs ffmpeg on PATH). Clips saved under REC_DIR/<cameraId>/.
REC_DIR=./recordings
REC_SEGMENT_SEC=600   # clip length (10 min)
REC_MAX_DAYS=7        # auto-delete footage older than this
REC_MAX_GB=0          # 0 = no size cap; e.g. 50 caps total footage at 50 GB
FFMPEG=ffmpeg         # path to ffmpeg if not on PATH

# Scheduler: hourly archive of camera SD -> server, daily safe-format.
ARCHIVE_EVERY_MIN=60   # pull camera SD recordings to server every N minutes
FORMAT_EVERY_HOURS=24  # default auto-format cadence (per-camera can override)
AUTO_FORMAT=1          # master switch for auto-format (0 = never auto-format)
